# DATABASE
DATABASE_URL=

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# GOOGLE AUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console.
# Local default for `uvicorn app:app` on port 8000; set the deployed HTTPS origin in production.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# RESEND
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM_EMAIL=admin@naijaclip.name.ng
MAIL_FROM_NAME=NaijaClip

# PAYSTACK
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=
PAYSTACK_MODE=test
AUTO_ACTIVATE_PRO=false

# FRONTEND
FRONTEND_URL=https://naijaclip.name.ng
MAX_FEATURED_HOMEPAGE_CLIPS=6

# TRACKING AND CAMERA
MIN_TRACKING_COVERAGE=0.95
CAMERA_SMOOTHING_ALPHA=0.08
CAMERA_DEAD_ZONE=64
CAMERA_MAX_STEP=48
CAMERA_MAX_VELOCITY=8
CAMERA_ACCELERATION=0.6
CAMERA_LOOK_AHEAD_SECONDS=0.12
CAMERA_LOOK_AHEAD_MAX=24
CAMERA_PATH_MAX_ERROR_PX=0.75
TRACK_LOST_HOLD_FRAMES=38
CAMERA_RETURN_SPEED=4

# PASSWORD RESET
RESET_CODE_EXPIRY_MINUTES=10
RESET_CODE_MAX_ATTEMPTS=5
RESET_CODE_RESEND_COOLDOWN_SECONDS=45
RESET_AUTHORIZATION_EXPIRY_MINUTES=10

# EMAIL VERIFICATION
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# PLANS
FREE_MONTHLY_VIDEO_LIMIT=3
PRO_MONTHLY_VIDEO_LIMIT=50

# INITIAL ADMIN
# Set ADMIN_EMAIL and ADMIN_PASSWORD before the first app initialization.
# After migrations, start the app; bootstrap creates this account only if no admin exists.
# Log in with it, open Dashboard > Clips, and feature/remove/reorder existing clips.
# The homepage reflects those changes from its featured-clips API without a redeploy.
ADMIN_NAME=NaijaClip Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
